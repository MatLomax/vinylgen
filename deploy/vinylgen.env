# Adjust these two absolute paths to match the service's install location.
VINYLGEN_DATA_DIR=/home/USER/vinylgen/.vinylgen-data
VINYLGEN_INKSCAPE_SHARED_DIR=/home/USER/vinylgen/.vinylgen-data/inkscape
# Public origin of the deployment, used by `just health-public` after deploy.
VINYLGEN_PUBLIC_URL=https://vinylgen.example.com
# SSH destination of the edge host the reverse tunnel runs to; `just install-services`
# renders it into vinylgen-tunnel.service.
VINYLGEN_TUNNEL_HOST=edge-host
VINYLGEN_MAX_UPLOAD_BYTES=104857600
VINYLGEN_MAX_ACTIVE_JOBS=2
VINYLGEN_RETENTION_DAYS=90
VINYLGEN_REQUIRE_PROXY_IDENTITY=1
PYTHONUNBUFFERED=1
DO_NOT_TRACK=1
