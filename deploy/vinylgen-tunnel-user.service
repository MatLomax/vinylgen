[Unit]
Description=Private Vinylgen reverse tunnel to Gandalf host
After=network-online.target vinylgen.service
Wants=network-online.target
Requires=vinylgen.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:8275:127.0.0.1:8275 samwise
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
